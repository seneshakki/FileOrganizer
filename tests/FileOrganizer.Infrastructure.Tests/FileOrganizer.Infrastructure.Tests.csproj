<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects build as self-executable test runners. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FileOrganizer.Application\FileOrganizer.Application.csproj" />
    <ProjectReference Include="..\..\src\FileOrganizer.Infrastructure\FileOrganizer.Infrastructure.csproj" />
    <ProjectReference Include="..\FileOrganizer.Infrastructure.LeaseProbe\FileOrganizer.Infrastructure.LeaseProbe.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLeaseProbe" AfterTargets="Build">
    <ItemGroup>
      <LeaseProbeArtifact Include="..\FileOrganizer.Infrastructure.LeaseProbe\bin\$(Configuration)\net10.0\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LeaseProbeArtifact)"
          DestinationFolder="$(OutDir)LeaseProbe" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
