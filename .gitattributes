# Normalize line endings in the repository so Windows, macOS and Linux
# checkouts produce identical blobs. Git auto-detects binary files.
* text=auto eol=lf

# Windows-only tooling that rejects LF.
*.sln text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must stay LF even when checked out on Windows.
*.sh text eol=lf
