<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileOrganizer.App.ViewModels"
        x:Class="FileOrganizer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1180" Height="800"
        MinWidth="800" MinHeight="560"
        Background="#0B101B">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E7ECF5" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#7DD3FC" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.4" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121A29" />
      <Setter Property="BorderBrush" Value="#263247" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="#0D1421" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Padding="28,22" Background="#0E1625" BorderBrush="#263247" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Subtitle}" Classes="muted" />
        </StackPanel>
        <Border Grid.Column="1" Background="#172A35" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="NO FILE EXECUTION" Classes="eyebrow" Foreground="#67E8F9" />
        </Border>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="20,10,20,20">
      <TabItem Header="Dashboard">
        <ScrollViewer>
          <StackPanel Margin="8,16,8,8" Spacing="18">
            <Border Classes="card">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="7">
                <TextBlock Text="ACTIVE WORKSPACE" Classes="eyebrow" Grid.ColumnSpan="2" />
                <TextBlock Grid.Row="1" Text="{Binding LoadState}" FontWeight="SemiBold" FontSize="18" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ConfigurationPath}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#B6C2D4"
                           TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasProblems}" BorderBrush="#7F4A55" Background="#24161D">
              <StackPanel Spacing="9">
                <TextBlock Text="ATTENTION REQUIRED" Classes="eyebrow" Foreground="#FDA4AF" />
                <ItemsControl ItemsSource="{Binding Problems}" x:CompileBindings="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Foreground="#FECDD3" TextWrapping="Wrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding ShowEmptyConfiguration}">
              <StackPanel Spacing="8">
                <TextBlock Text="NO WATCH ROOTS" Classes="eyebrow" />
                <TextBlock Text="The configuration is valid, but it contains no watched folders."
                           Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Roots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WatchRootViewModel">
                  <Border Classes="card" Margin="0,0,0,18">
                    <StackPanel Spacing="16">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="6">
                          <TextBlock Text="WATCH ROOT" Classes="eyebrow" />
                          <TextBlock Text="{Binding RootPath}" FontSize="18" FontWeight="SemiBold"
                                     FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{Binding State}" Foreground="#7DD3FC" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StateDescription}" Classes="muted" />
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="{Binding IsEnabled, StringFormat='Enabled: {0}'}" Classes="muted" />
                            <TextBlock Text="{Binding IncludeSubdirectories, StringFormat='Subdirectories: {0}'}" Classes="muted" />
                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" Classes="muted" FontSize="11" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                          <Button Content="Pause" Command="{Binding PauseCommand}" />
                          <Button Content="Resume" Command="{Binding ResumeCommand}" />
                          <Button Content="Reconnect watcher" Command="{Binding ReconnectCommand}" />
                          <Button Content="Retry baseline" Command="{Binding RetryCommand}" />
                        </StackPanel>
                      </Grid>

                      <Border Background="#0D1421" CornerRadius="8" Padding="12">
                        <TextBlock Text="{Binding LatestDiagnostic}" Classes="muted" TextWrapping="Wrap" />
                      </Border>

                      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <Border Classes="metric">
                          <StackPanel>
                            <TextBlock Text="TOTAL" Classes="eyebrow" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="metric">
                          <StackPanel>
                            <TextBlock Text="READY" Classes="eyebrow" Foreground="#86EFAC" />
                            <TextBlock Text="{Binding ReadyCount}" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="metric">
                          <StackPanel>
                            <TextBlock Text="SKIPPED" Classes="eyebrow" Foreground="#CBD5E1" />
                            <TextBlock Text="{Binding SkippedCount}" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="metric">
                          <StackPanel>
                            <TextBlock Text="BLOCKED" Classes="eyebrow" Foreground="#FDE68A" />
                            <TextBlock Text="{Binding BlockedCount}" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="metric">
                          <StackPanel>
                            <TextBlock Text="CONFLICT" Classes="eyebrow" Foreground="#FDA4AF" />
                            <TextBlock Text="{Binding ConflictCount}" FontSize="22" FontWeight="SemiBold" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" ColumnSpacing="8">
                        <TextBlock Text="Preview" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding PreviewOutcome}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Trigger" Classes="muted" />
                        <TextBlock Grid.Column="3" Text="{Binding PreviewTrigger}" />
                        <TextBlock Grid.Column="4" Text="Generated" Classes="muted" />
                        <TextBlock Grid.Column="5" Text="{Binding PlanGeneratedAt}" />
                      </Grid>
                      <TextBlock Text="{Binding PreviewProblem}" Classes="muted" TextWrapping="Wrap" />

                      <Expander Header="Historical plan items" IsVisible="{Binding HasPlanItems}">
                        <ItemsControl ItemsSource="{Binding PlanItems}" Margin="0,10,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlanItemViewModel">
                              <Border BorderBrush="#263247" BorderThickness="0,1,0,0" Padding="0,12">
                                <Grid ColumnDefinitions="2*,Auto,3*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="5">
                                  <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1" Text="{Binding Outcome}" Foreground="#7DD3FC" />
                                  <TextBlock Grid.Column="2" Text="{Binding Action}" HorizontalAlignment="Right" />
                                  <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding SourcePath}" Classes="muted"
                                             FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                  <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding TargetPath, StringFormat='Target: {0}'}"
                                             Classes="muted" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                                  <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="{Binding Reasons}" Classes="muted" TextWrapping="Wrap" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Expander>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Configuration">
        <Grid Margin="8,16,8,8" RowDefinitions="Auto,Auto,*" RowSpacing="16">
          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="5">
                  <TextBlock Text="CONFIGURATION WORKSPACE" Classes="eyebrow" />
                  <TextBlock Text="{Binding Editor.Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Editor.ConfigurationPath, StringFormat='Document: {0}'}"
                             Classes="muted" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Editor.ActiveConfigurationPath, StringFormat='Active preview: {0}'}"
                             Classes="muted" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                  <TextBlock Text="{Binding Editor.LoadState}" Foreground="#7DD3FC" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Editor.IsDirty, StringFormat='Unsaved: {0}'}" Classes="muted" />
                  <TextBlock Text="{Binding Editor.IsBusy, StringFormat='Busy: {0}'}" Classes="muted" />
                </StackPanel>
              </Grid>

              <WrapPanel Orientation="Horizontal">
                <Button Content="Open" Command="{Binding Editor.OpenCommand}" Margin="0,0,8,8" />
                <Button Content="New / Create" Command="{Binding Editor.CreateCommand}" Margin="0,0,8,8" />
                <Button Content="Reload" Command="{Binding Editor.ReloadCommand}" Margin="0,0,8,8" />
                <Button Content="Validate" Command="{Binding Editor.ValidateCommand}" Margin="0,0,8,8" />
                <Button Content="Save" Command="{Binding Editor.SaveCommand}" Margin="0,0,8,8" />
                <Button Content="Revert edits" Command="{Binding Editor.RevertCommand}" Margin="0,0,8,8" />
                <Button Content="Import" Command="{Binding Editor.ImportCommand}" Margin="0,0,8,8" />
                <Button Content="Export" Command="{Binding Editor.ExportCommand}" Margin="0,0,0,8" />
              </WrapPanel>

              <TextBlock Text="Save and Import validate before atomic config publication. Copy and literal Rename remain planning-only; this screen cannot execute file operations."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="card" IsVisible="{Binding Editor.HasProblems}"
                  BorderBrush="#7F4A55" Background="#24161D">
            <StackPanel Spacing="9">
              <TextBlock Text="VALIDATION / STORAGE PROBLEMS" Classes="eyebrow" Foreground="#FDA4AF" />
              <ItemsControl ItemsSource="{Binding Editor.Problems}" x:CompileBindings="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#FECDD3" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Classes="card" IsVisible="{Binding Editor.HasDocument}" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <TextBlock Text="SCHEMA V1 JSON" Classes="eyebrow" />
              <TextBox Grid.Row="1"
                       Text="{Binding Editor.ConfigurationText, Mode=TwoWay}"
                       AcceptsReturn="True"
                       IsReadOnly="{Binding Editor.IsBusy}"
                       TextWrapping="NoWrap"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="13"
                       MinHeight="360"
                       Padding="14"
                       Background="#090F19"
                       Foreground="#DCE7F7"
                       BorderBrush="#263247" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
