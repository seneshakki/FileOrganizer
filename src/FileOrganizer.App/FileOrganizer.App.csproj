<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop shell. It composes the application and renders it; the rules
    themselves live in Core and the machine access in Infrastructure.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Ships a font so text renders the same on Linux, where a suitable
         default font is not guaranteed to be installed. -->
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Developer tools, excluded from every non-Debug build. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileOrganizer.Application\FileOrganizer.Application.csproj" />
    <ProjectReference Include="..\FileOrganizer.Core\FileOrganizer.Core.csproj" />
    <ProjectReference Include="..\FileOrganizer.Infrastructure\FileOrganizer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
